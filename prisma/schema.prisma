generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CoupleRole {
  OWNER
  PARTNER
}

enum Visibility {
  PRIVATE
  PARTNER
  SHARED
}

enum MoodEnergy {
  LOW
  MEDIUM
  HIGH
}

enum WishStatus {
  IDEA
  PLANNED
  DONE
  PAUSED
}

enum TimeCapsuleStatus {
  LOCKED
  OPENED
}

enum AgentRunStatus {
  SUCCESS
  FALLBACK
  ERROR
}

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  name             String
  passwordHash     String
  avatarUrl        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  sessions         AuthSession[]
  memberships      CoupleMember[]
  diaryEntries     DiaryEntry[]
  moodCheckIns     MoodCheckIn[]
  wishes           Wish[]              @relation("WishCreator")
  photos           Photo[]
  agentRuns        AgentRun[]
  wishStatusHistory WishStatusHistory[]
  notifications    Notification[]
  checkIns         CheckIn[]
}

model AuthSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  deviceName String?  @map("device_name")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Couple {
  id                   String          @id @default(cuid())
  inviteCode           String          @unique
  title                String          @default("我们的空间")
  startedAt            DateTime?
  inviteCodeExpiresAt  DateTime?       @map("invite_code_expires_at")
  inviteCodeCreatedAt  DateTime?       @map("invite_code_created_at")
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  members              CoupleMember[]
  anniversaries        Anniversary[]
  diaryEntries         DiaryEntry[]
  moodCheckIns         MoodCheckIn[]
  wishes               Wish[]
  photos               Photo[]
  timeCapsules         TimeCapsule[]
  agentMemories        AgentMemory[]
  agentRuns            AgentRun[]
  notifications        Notification[]
  checkIns             CheckIn[]
}

model CoupleMember {
  id        String     @id @default(cuid())
  userId    String
  coupleId  String
  role      CoupleRole @default(PARTNER)
  joinedAt  DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  couple    Couple     @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@unique([userId, coupleId])
  @@index([coupleId])
}

model Anniversary {
  id          String   @id @default(cuid())
  coupleId    String
  title       String
  happenedAt  DateTime
  remindDays  Int[]    @default([30, 7, 1])
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  couple      Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@index([coupleId, happenedAt])
}

model DiaryEntry {
  id          String     @id @default(cuid())
  coupleId    String
  authorId    String
  title       String
  content     String
  visibility  Visibility @default(SHARED)
  happenedAt  DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  couple      Couple     @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([coupleId, happenedAt])
  @@index([authorId])
}

model MoodCheckIn {
  id             String     @id @default(cuid())
  coupleId       String
  userId         String
  mood           String
  energy         MoodEnergy @default(MEDIUM)
  stressLevel    Int        @default(3)
  carePreference String?
  note           String?
  checkedAt      DateTime   @default(now())
  couple         Couple     @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([coupleId, checkedAt])
  @@index([userId, checkedAt])
}

model Wish {
  id            String              @id @default(cuid())
  coupleId      String
  creatorId     String
  title         String
  category      String
  status        WishStatus          @default(IDEA)
  targetAt      DateTime?
  budgetCents   Int?
  note          String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  couple        Couple              @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  creator       User                @relation("WishCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  statusHistory WishStatusHistory[]

  @@index([coupleId, status])
  @@index([creatorId])
}

model Photo {
  id          String   @id @default(cuid())
  coupleId    String
  uploaderId  String
  url         String
  title       String?
  event       String?
  takenAt     DateTime?
  createdAt   DateTime @default(now())
  couple      Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([coupleId, takenAt])
}

model TimeCapsule {
  id          String            @id @default(cuid())
  coupleId    String
  title       String
  content     String
  unlockAt    DateTime
  status      TimeCapsuleStatus @default(LOCKED)
  openedAt    DateTime?
  createdAt   DateTime          @default(now())
  couple      Couple            @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@index([coupleId, unlockAt])
}

model AgentMemory {
  id        String   @id @default(cuid())
  coupleId  String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@unique([coupleId, key])
}

model AgentRun {
  id        String         @id @default(cuid())
  coupleId  String?
  userId    String?
  intent    String
  input     Json
  output    Json
  status    AgentRunStatus @default(SUCCESS)
  createdAt DateTime       @default(now())
  couple    Couple?        @relation(fields: [coupleId], references: [id], onDelete: SetNull)
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([coupleId, createdAt])
  @@index([userId, createdAt])
}

model WishStatusHistory {
  id         String     @id @default(cuid())
  wishId     String
  fromStatus WishStatus?
  toStatus   WishStatus
  changedBy  String
  changedAt  DateTime   @default(now())
  wish       Wish       @relation(fields: [wishId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [changedBy], references: [id], onDelete: Cascade)

  @@index([wishId, changedAt])
}

model Notification {
  id        String   @id @default(cuid())
  coupleId  String
  userId    String?
  type      String
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([coupleId, createdAt])
  @@index([userId, readAt])
}

model CheckIn {
  id          String   @id @default(cuid())
  coupleId    String
  userId      String
  title       String
  note        String?
  imageUrl    String?  @map("image_url")
  location    String?
  longitude   Float?
  latitude    Float?
  address     String?
  checkedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  couple      Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([coupleId, checkedAt])
  @@index([userId])
}
